# Copy to .env and fill in values. Never commit .env.

HOST=127.0.0.1
PORT=8000
DATA_DIR=data
# Recordings are re-encoded to ~14 MB/hour before transcription, so uploads
# can be much larger than Groq's own 25 MB per-request audio cap.
MAX_UPLOAD_MB=200

# Groq — powers transcription (Whisper), summaries and Q&A.
# Free tier, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_...

# Comma-separated origins allowed to call this API cross-origin. Only needed
# if you host the frontend separately from this backend.
# ALLOWED_ORIGINS=https://your-frontend.example.com

# Set true only behind a reverse proxy that sets X-Forwarded-For (rate limits
# use the client IP; without a proxy, clients could spoof the header).
# TRUST_PROXY_HEADERS=false

# --- Optional tuning (defaults shown) ---
# RUN_WORKERS=true            # false when workers run separately (python -m backend.app.worker)
# WORKER_CONCURRENCY=2        # meetings processed at once per process
# LLM_TOKENS_PER_MINUTE=7000  # shared budget per model; Groq free tier allows 8000
# FALLBACK_MODEL=openai/gpt-oss-20b  # used when the main model's budget is full ("" disables)
# FALLBACK_AFTER_SECONDS=8    # how long to wait for the main model before falling back
# SKIP_SILENCE_SECONDS=2.0    # pauses longer than this are shortened before transcription (0 = off)
# KEEP_SILENCE_SECONDS=0.6    # ...to this length
# LIVE_PRESUMMARIZE=true      # summarize finished sections while a live recording is going
# MAX_QUEUE_DEPTH=50          # above this, new uploads get 503 + Retry-After
# MAX_QUEUED_PER_OWNER=5      # meetings one user may have waiting at once
# CHUNK_SECONDS=600           # audio per transcription request
# TRANSCRIBE_PARALLELISM=3    # chunks transcribed at once per meeting
# RETENTION_DAYS=30           # auto-delete meetings after this many days (0 = never)
# RETAIN_AUDIO=false          # keep uploaded audio after processing
