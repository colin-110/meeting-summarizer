# Copy to .env and fill in values. Never commit .env.

HOST=127.0.0.1
PORT=8000
DATA_DIR=data
# Groq's free-tier transcription API hard-caps audio at 25MB — raising this
# past 25 just delays the failure until the transcription step instead of
# catching it at upload.
MAX_UPLOAD_MB=25

# Groq — powers both ASR (Whisper) and summarization (Llama).
# Free tier, no credit card: https://console.groq.com
GROQ_API_KEY=gsk_...
